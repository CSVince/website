---
import Layout from '../layouts/Layout.astro';

// Place your resume PDF at: public/resume.pdf
const resumePath = "/resume.pdf";
---

<Layout title="Resume" description="Vincent Nguyen's Resume">

  <section class="pb-10 border-b border-slate-100">
    <p class="text-blue-600 font-semibold text-sm tracking-widest uppercase mb-4">Resume</p>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 leading-tight mb-2">Vincent Nguyen</h1>
    <p class="text-lg text-blue-600 font-semibold mb-8">Likely outdated. Let's hope I won't need it any time soon 🤞</p>
    <div class="flex flex-wrap gap-3">
      <a
        href={resumePath}
        download="VincentNguyen_Resume.pdf"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-blue-600 text-white font-semibold text-sm hover:bg-blue-700 transition-colors shadow-sm"
      >
        ↓ Download PDF
      </a>
      <a
        href={resumePath}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-slate-200 text-slate-700 font-semibold text-sm hover:border-blue-600 hover:text-blue-600 transition-colors"
      >
        Open in new tab ↗
      </a>
    </div>
  </section>

  <div class="mt-10 relative rounded-2xl border border-slate-200 overflow-hidden bg-slate-50 min-h-[700px]">
    <!-- Shown until PDF loads -->
    <div id="pdf-placeholder" class="absolute inset-0 flex flex-col items-center justify-center text-center p-8 pointer-events-none">
      <div class="w-14 h-14 rounded-xl bg-slate-200 flex items-center justify-center mb-4 text-2xl">📄</div>
      <p class="text-slate-500 text-sm max-w-sm leading-relaxed">
        Loading...
      </p>
    </div>
    <iframe
      src={resumePath}
      id="pdf-frame"
      title="Vincent Nguyen Resume"
      class="w-full h-[900px] block border-none opacity-0 transition-opacity duration-300"
    ></iframe>
  </div>

</Layout>

<script>
  const frame = document.getElementById('pdf-frame') as HTMLIFrameElement;
  const placeholder = document.getElementById('pdf-placeholder');

  if (frame && placeholder) {
    frame.addEventListener('load', () => {
      placeholder.style.display = 'none';
      frame.style.opacity = '1';
    });
  }
</script>
