---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Blog" description="Vincent Nguyen's Blog">

  <section class="pb-8 border-b border-slate-100 dark:border-slate-800">
    <p class="text-blue-600 dark:text-blue-400 font-semibold text-sm tracking-widest uppercase mb-4">Blog</p>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-slate-50 leading-tight mb-4">
      My thoughts and musings
    </h1>
    <p class="text-lg text-slate-500 dark:text-slate-400">I'll get around to this one day...</p>
  </section>

</Layout>
