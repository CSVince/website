---
import Layout from '../layouts/Layout.astro';

const jobs = [
  {
    company: "Atlassian",
    role: "Software Engineer",
    dates: "Feb 2025 – Present",
    location: "Sydney, Australia",
    bullets: [
      "Modernised and migrated legacy platform capabilities to next-generation systems, enabling large-scale app partner migrations",
      "Led end-to-end delivery of major cross-product platform features across multiple teams and systems",
      "Built customer-facing tooling to support seamless upgrades across hundreds of thousands of global app installations",
    ],
  },
  {
    company: "UNSW Computer Science and Engineering",
    role: "Casual Academic",
    dates: "Sep 2024 – Dec 2024",
    location: "Sydney, Australia",
    bullets: [
      "Taught COMP6991 - Solving Modern Programming Problems with Rust (24T3)",
      "Taught COMP2511 - Object Oriented Design & Programming (24T3)",
      "Inspiring the next generation of software engineers"
    ],
  },
  {
    company: "Atlassian",
    role: "Software Engineering Intern",
    dates: "Nov 2023 – Feb 2024",
    location: "Sydney, Australia",
    bullets: [
      "Implemented networking capabilities on service with high traffic volumes of up to 2000000 requests per second.",
      "Integrated comprehensive, cloud-based application into existing codebases for performance monitoring & error tracking",
      "Rectified a critical bug in company-wide software, significantly enhancing system reliability and optimizing overall performance",
    ],
  },
  {
    company: "Macquarie Group",
    role: "Software Engineering Intern",
    dates: "Jan 2023 – Sep 2023",
    location: "Sydney, Australia",
    bullets: [
      "Utilised Prometheus, Grafana and Loki logs and metrics to cut computing and memory costs by $1200000",
      "Implemented API endpoints and refactored large-scale Java backend to satisfy updated business requirements"
    ],
  },
  {
    company: "Optus",
    role: "Software Engineering Intern",
    dates: "Jul 2022 – Dec 2022",
    location: "Sydney, Australia",
    bullets: [
      "Migrated legacy pipelines and procedures by building a NodeJS backend and React frontend to increase workflow efficiency by over 200%",
      "Designed and developed tactical solution in a NodeJS backend, consumed up to 10000 times with 100% success rate",
      "Scripted pipelines to automatically build and deploy project Docker images, reducing deployment times by over 100%",
      "Confirmed not the cause of the 2022 data breach despite deploying to prod the Friday before",
    ],
  },
  {
    company: "Peak HSC",
    role: "Senior Chemistry Tutor",
    dates: "Jan 2021 – Mar 2026",
    location: "Sydney, Australia",
    bullets: [
      "Teaching Year 12 Chemistry",
      "Inspiring the next generation of chemists",
    ],
  },
];

const projects = [
  {
    name: "Dungeon Mania",
    description: "Game built in Java supporting a bunch of cool features such as battle, time-travel, consumables, and persistence awarded a final mark of 100%",
    tech: ["Java"],
    links: [
      { label: "GitHub", href: "https://github.com/CSVince/Dungeonmania" },
    ],
  },
  {
    name: "Microsoft Teams Clone",
    description: "Python web application with a functioning frontend and backend mimicking functionality of Microsoft Teams, receiving a final mark of 93.",
    tech: ["Python", "Flask"],
    links: [
      { label: "GitHub", href: "https://github.com/CSVince/MockTeams" },
    ],
  },
];
---

<Layout title="Experience" description="Vincent Nguyen's professional experience and projects">

  <!-- Header -->
  <section class="pb-8 border-b border-slate-100 dark:border-slate-800">
    <p class="text-blue-600 dark:text-blue-400 font-semibold text-sm tracking-widest uppercase mb-4">Experience</p>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-slate-50 leading-tight mb-6">What have I been up to?</h1>
  </section>

  <section class="py-8 border-b border-slate-100 dark:border-slate-800">
    <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-8">Work Experience</h2>
    <div class="space-y-5">
      {jobs.map((job) => (
        <article class="p-6 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 hover:border-blue-200 dark:hover:border-blue-700 hover:bg-blue-50/30 dark:hover:bg-blue-900/10 transition-colors">
          <div class="flex flex-wrap justify-between items-start gap-3 mb-4">
            <div>
              <h3 class="text-base font-bold text-slate-900 dark:text-slate-50">{job.role}</h3>
              <p class="text-blue-600 dark:text-blue-400 font-semibold text-sm mt-0.5">{job.company}</p>
            </div>
            <div class="text-right">
              <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">{job.dates}</p>
              <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">{job.location}</p>
            </div>
          </div>
          <ul class="space-y-1.5 pl-4 border-l-2 border-slate-200 dark:border-slate-700">
            {job.bullets.map((b) => (
              <li class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">{b}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section class="pt-14">
    <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-8">Projects</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {projects.map((proj) => (
        <article class="p-6 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 hover:border-blue-200 dark:hover:border-blue-700 hover:shadow-sm transition-all flex flex-col">
          <div class="flex justify-between items-start gap-2 mb-3">
            <h3 class="text-base font-bold text-slate-900 dark:text-slate-50">{proj.name}</h3>
            <div class="flex gap-3 shrink-0">
              {proj.links.map((l) => (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 text-xs font-semibold whitespace-nowrap"
                >
                  {l.label} →
                </a>
              ))}
            </div>
          </div>
          <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-4 flex-1">{proj.description}</p>
          <div class="flex flex-wrap gap-1.5">
            {proj.tech.map((t) => (
              <span class="px-2.5 py-0.5 rounded-full border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 text-xs font-medium bg-white dark:bg-slate-800">
                {t}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

</Layout>
