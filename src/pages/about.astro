---
import Layout from '../layouts/Layout.astro';

const skills = {
  "Languages": ["Python", "JavaScript", "TypeScript", "Java", "C++"],
  "Frameworks": ["React", "Node.js", "Astro", "FastAPI"],
  "Tools": ["Git", "Docker", "PostgreSQL", "Linux"],
};
---

<Layout title="About" description="About Vincent Nguyen — Software Engineer">

  <!-- Header -->
  <section class="pb-14 border-b border-slate-100">
    <p class="text-blue-600 font-semibold text-sm tracking-widest uppercase mb-4">About Me</p>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 leading-tight mb-6">
      Hi, I'm Vincent
    </h1>
    <p class="text-lg text-slate-500 max-w-2xl leading-relaxed">
      I'm a software engineer with a passion for building clean, reliable software.
      I enjoy working across the stack and am always looking for ways to improve my craft.
    </p>
  </section>

  <!-- Bio + Skills -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-16 py-14 border-b border-slate-100">

    <section>
      <h2 class="text-xl font-bold text-slate-900 mb-5">Background</h2>
      <div class="space-y-4 text-slate-500 leading-relaxed">
        <p>
          <!-- Replace with your story -->
          I've been writing code since [year] and am currently studying computer science.
          I'm drawn to problems that sit at the intersection of engineering and real-world impact.
        </p>
        <p>
          When I'm not at my desk, you'll find me [hobbies — e.g., hiking, reading, playing chess].
          I believe in writing code that others can read and software that people actually want to use.
        </p>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-bold text-slate-900 mb-5">Skills</h2>
      <div class="space-y-5">
        {Object.entries(skills).map(([category, items]) => (
          <div>
            <p class="text-xs font-semibold tracking-widest uppercase text-slate-400 mb-2">{category}</p>
            <div class="flex flex-wrap gap-2">
              {items.map((skill) => (
                <span class="px-3 py-1 rounded-full border border-slate-200 text-slate-600 text-sm font-medium bg-slate-50">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>

  <!-- Contact -->
  <section class="pt-14">
    <h2 class="text-xl font-bold text-slate-900 mb-2">Get in Touch</h2>
    <p class="text-slate-500 mb-6">
      I'm always open to interesting conversations, opportunities, or just saying hello.
    </p>
    <div class="flex items-center gap-5">

      <a href="https://github.com/CSVince" target="_blank" rel="noopener" aria-label="GitHub" class="text-slate-400 hover:text-slate-900 transition-colors">
        <!-- GitHub -->
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>

      <a href="https://www.linkedin.com/in/vincent-nguyen-539906183/" target="_blank" rel="noopener" aria-label="LinkedIn" class="text-slate-400 hover:text-blue-600 transition-colors">
        <!-- LinkedIn -->
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>

      <a href="mailto:vvvincent288@gmail.com" aria-label="Email" class="text-slate-400 hover:text-blue-600 transition-colors">
        <!-- Mail -->
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
      </a>

    </div>
  </section>

</Layout>
